RAGRUN_APP_ENV=development
RAGRUN_API_HOST=0.0.0.0
RAGRUN_API_PORT=8000
RAGRUN_QDRANT_URL=http://localhost:6333
RAGRUN_POSTGRES_DSN=postgresql+psycopg://ragrun:ragrun@localhost:15432/ragrun
# If running inside Docker containers, override with:
# RAGRUN_POSTGRES_DSN=postgresql+psycopg://ragrun:ragrun@postgres:5432/ragrun
RAGRUN_EMBEDDINGS_BASE_URL=http://localhost:8001
RAGRUN_LANGFUSE_HOST=
RAGRUN_LANGFUSE_PUBLIC_KEY=
RAGRUN_LANGFUSE_SECRET_KEY=
RAGRUN_LANGFUSE_INGESTION_DATASET=ingestion_runs

# Retrieval sizing (concept_explain_worldviews graph)
# These cap the number of reranked chunks kept after retrieval.
# To get more than 6 chunks, set (at least) the concept value to 20.
RAGRUN_CEWV_K_FINAL_CONCEPT=6
RAGRUN_CEWV_K_FINAL_CONTEXT1=4
RAGRUN_CEWV_K_FINAL_CONTEXT2=6

# For ragprep CLI (when connecting from host machine to Docker services)
# Set this in ragprep's environment:
# export RAGRUN_BASE_URL=http://localhost:8000/api/v1

# Supabase (ragapp JWT validation + sync RPC forwarding)
# Preferred ragrun names:
RAGRUN_SUPABASE_URL=https://your-project.supabase.co
RAGRUN_SUPABASE_ANON_KEY=your-anon-key
RAGRUN_SUPABASE_JWT_SECRET=your-jwt-secret
# Or reuse ragapp names already in .env (URL + anon key only):
# EXPO_PUBLIC_SUPABASE_URL=...
# EXPO_PUBLIC_SUPABASE_ANON_KEY=...
# JWT secret optional if project uses JWT Signing Keys (JWKS) — ragrun validates via
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json when secret is unset.
# Legacy secret (if visible): Settings → JWT Keys → JWT Secret (Legacy)
RAGRUN_SUPABASE_JWT_SECRET=

# Default assistant slug for /app/search when collection is omitted
RAGRUN_APP_DEFAULT_ASSISTANT_SLUG=philo-von-freisinn
