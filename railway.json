{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "Dockerfile"
    },
    "deploy": {
        "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port $PORT",
        "healthcheckPath": "/health",
        "healthcheckTimeout": 100,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    },
    "environments": {
        "production": {
            "variables": {
                "VECTOR_DB_TYPE": "local",
                "LOCAL_VECTOR_DB_PATH": "/app/data/vector_db",
                "LOCAL_VECTOR_COLLECTION_NAME": "philosophical_768",
                "EMBEDDINGS_DIMENSION": "768",
                "CHROMADB_ANONYMIZED_TELEMETRY": "false",
                "CHROMADB_ALLOW_RESET": "false",
                "ENVIRONMENT": "production",
                "DEBUG": "false",
                "LOG_LEVEL": "INFO",
                "PYTHONPATH": "/app",
                "PYTHONUNBUFFERED": "1"
            }
        },
        "staging": {
            "variables": {
                "VECTOR_DB_TYPE": "local",
                "LOCAL_VECTOR_DB_PATH": "/app/data/vector_db",
                "LOCAL_VECTOR_COLLECTION_NAME": "philosophical_768_staging",
                "EMBEDDINGS_DIMENSION": "768",
                "CHROMADB_ANONYMIZED_TELEMETRY": "false",
                "CHROMADB_ALLOW_RESET": "true",
                "ENVIRONMENT": "staging",
                "DEBUG": "true",
                "LOG_LEVEL": "DEBUG"
            }
        }
    }
}
