# Copy to Tuxai, e.g. /etc/cloudflared/config.yml
# Replace <TUNNEL-UUID> and hostnames with your Cloudflare tunnel + DNS names.

tunnel: <TUNNEL-UUID>
credentials-file: /etc/cloudflared/<TUNNEL-UUID>.json

ingress:
  - hostname: qdrant.ragxxx.com
    service: http://127.0.0.1:6333
  - hostname: qdrant-staging.ragxxx.com
    service: http://127.0.0.1:6334
  - hostname: embed.ragxxx.com
    service: http://127.0.0.1:8001
  - service: http_status:404
