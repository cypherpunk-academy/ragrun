{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Rechner",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Host-CPU über node_cpu_seconds_total.",
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "legendFormat": "CPU",
          "refId": "A"
        }
      ],
      "title": "CPU",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Belegter RAM aus node_memory_MemAvailable_bytes und node_memory_MemTotal_bytes.",
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "belegt",
          "refId": "A"
        }
      ],
      "title": "RAM",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Belegung von / aus node_filesystem_size_bytes und node_filesystem_avail_bytes, ohne tmpfs und overlay.",
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "targets": [
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})",
          "legendFormat": "{{fstype}} {{mountpoint}}",
          "refId": "A"
        }
      ],
      "title": "Platte /",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "node_network_receive_bytes_total und node_network_transmit_bytes_total. Das sind die Schnittstellen des Containers, nicht des Hosts.",
      "fieldConfig": {
        "defaults": { "unit": "Bps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 5,
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total[5m])",
          "legendFormat": "empfangen {{device}}",
          "refId": "A"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total[5m])",
          "legendFormat": "gesendet {{device}}",
          "refId": "B"
        }
      ],
      "title": "Netz",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "node_hwmon_temp_celsius, falls der Exporter den Sensor sieht.",
      "fieldConfig": {
        "defaults": { "unit": "celsius" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 6,
      "targets": [
        {
          "expr": "node_hwmon_temp_celsius",
          "legendFormat": "{{chip}} {{sensor}}",
          "refId": "A"
        }
      ],
      "title": "Temperatur",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 7,
      "title": "Container",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "container_cpu_usage_seconds_total für die Container qdrant und ragrun-embeddings.",
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "id": 8,
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{name=~\"/?qdrant|/?ragrun-embeddings\"}[5m])",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "CPU je Container",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "container_memory_working_set_bytes für die Container qdrant und ragrun-embeddings.",
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "id": 9,
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{name=~\"/?qdrant|/?ragrun-embeddings\"}",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "RAM je Container",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 10,
      "title": "Embedder",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "rate von embedder_requests_total.",
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "id": 11,
      "targets": [
        {
          "expr": "sum by (endpoint, status) (rate(embedder_requests_total[5m]))",
          "legendFormat": "{{endpoint}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "Anfragen pro Sekunde",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "histogram_quantile über embedder_encode_seconds.",
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "id": 12,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(embedder_encode_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(embedder_encode_seconds_bucket[5m])))",
          "legendFormat": "Median",
          "refId": "B"
        }
      ],
      "title": "Encode-Zeit",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Mittelwert aus embedder_texts_per_request_sum und embedder_texts_per_request_count.",
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 35 },
      "id": 13,
      "targets": [
        {
          "expr": "sum(rate(embedder_texts_per_request_sum[5m])) / sum(rate(embedder_texts_per_request_count[5m]))",
          "legendFormat": "Texte pro Anfrage",
          "refId": "A"
        }
      ],
      "title": "Texte pro Anfrage",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "embedder_model_loaded.",
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "max": 1 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 35 },
      "id": 14,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "embedder_model_loaded",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "title": "Modell geladen",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "embedder_model_load_seconds.",
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 35 },
      "id": 15,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "embedder_model_load_seconds",
          "legendFormat": "Ladezeit",
          "refId": "A"
        }
      ],
      "title": "Modell-Ladezeit",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 },
      "id": 16,
      "title": "Qdrant",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "app_info.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 44 },
      "id": 17,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "name"
      },
      "targets": [
        {
          "expr": "app_info",
          "legendFormat": "{{name}} {{version}}",
          "refId": "A"
        }
      ],
      "title": "Version",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "collections_total.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 44 },
      "id": 18,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "expr": "collections_total", "legendFormat": "Collections", "refId": "A" }
      ],
      "title": "Collections",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "collections_vector_total.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 44 },
      "id": 19,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "expr": "collections_vector_total", "legendFormat": "Vektoren", "refId": "A" }
      ],
      "title": "Vektoren",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "cluster_enabled.",
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1 }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 44 },
      "id": 20,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "expr": "cluster_enabled", "legendFormat": "Cluster", "refId": "A" }
      ],
      "title": "Cluster",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "app_status_recovery_mode.",
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1 }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 44 },
      "id": 21,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "expr": "app_status_recovery_mode", "legendFormat": "Recovery", "refId": "A" }
      ],
      "title": "Recovery-Modus",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "rate von rest_responses_total.",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "id": 22,
      "targets": [
        {
          "expr": "sum by (method, endpoint, status) (rate(rest_responses_total[5m]))",
          "legendFormat": "{{method}} {{endpoint}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "Antworten pro Sekunde",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "rate von rest_responses_fail_total.",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "id": 23,
      "targets": [
        {
          "expr": "sum by (method, endpoint, status) (rate(rest_responses_fail_total[5m]))",
          "legendFormat": "{{method}} {{endpoint}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "Fehlgeschlagene Antworten",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "rest_responses_avg_duration_seconds, rest_responses_min_duration_seconds, rest_responses_max_duration_seconds und das 95-%-Quantil von rest_responses_duration_seconds.",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 56 },
      "id": 24,
      "targets": [
        {
          "expr": "sum by (method, endpoint) (rest_responses_avg_duration_seconds)",
          "legendFormat": "Mittel {{method}} {{endpoint}}",
          "refId": "A"
        },
        {
          "expr": "sum by (method, endpoint) (rest_responses_min_duration_seconds)",
          "legendFormat": "Min {{method}} {{endpoint}}",
          "refId": "B"
        },
        {
          "expr": "sum by (method, endpoint) (rest_responses_max_duration_seconds)",
          "legendFormat": "Max {{method}} {{endpoint}}",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rest_responses_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "D"
        }
      ],
      "title": "Antwortzeit",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["tuxai", "ragrun"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
