# Kopie:  cp scripts/secrets/rotate.env.example scripts/secrets/rotate.env
# Dann nur die Werte ausfüllen, die du wirklich neu setzt.
# Leere Zeilen = diese Variable überspringen.
#
# Niemals committen. Rechte: chmod 600 scripts/secrets/rotate.env
#
# Nur Secrets, die der laufende Dienst liest.
# Keine URLs, keine Schalter (APP_ENV, EMBEDDINGS_PROVIDER, HYBRID, MCP_BASE_URL).
# Nicht hier: Hugging Face (Provider ist http), Legacy-JWT-Secret, Anon/Publishable Key,
# R2, Internal API Key, Grafana.
#
# Alten Wert erst ungültig machen, wenn Railway den neuen hat.
# Solange Builds pausiert sind, keinen Reset und kein Rotate-sofort ausführen:
# der laufende Dienst schickt weiter den alten Wert.

# --- Ziele (1 = ja, 0 = nein) ---
# RAILWAY_STAGING    = Service ragrun-staging
# RAILWAY_PRODUCTION = Service ragrun
# TUXAI              = Pulse ~/ragrun-server/.env, nur QDRANT_API_KEY
# Lokal              = .env.staging / .env.production und ragprep-DSNs
APPLY_RAILWAY_STAGING=1
APPLY_RAILWAY_PRODUCTION=1
APPLY_LOCAL_RAGRUN=1
APPLY_LOCAL_RAGPREP=1
APPLY_TUXAI=0

RAILWAY_PROJECT_ID=4fc5cea8-9f49-42af-b624-a0f3e5232245
RAILWAY_PRODUCTION_SERVICE=ragrun
RAILWAY_STAGING_SERVICE=ragrun-staging

# Nur mit APPLY_TUXAI=1. SSH-Alias aus ~/.ssh/config: Host tuxai → ssh.ragxxx.com
# Leer lassen und APPLY_TUXAI=0, wenn du den Key auf dem Pulse von Hand einträgst.
TUXAI_SSH_HOST=
TUXAI_ENV_REMOTE=~/ragrun-server/.env

# --- SUPABASE: Service Role ---
# Zahnrad unten → Project Settings → API Keys
# Reiter "Publishable and secret API keys" → "+ New secret key"
# Wert beginnt mit sb_secret_ und wird nur einmal vollständig angezeigt.
# Gleicher Wert wird lokal auch als SUPABASE_SERVICE_ROLE_KEY geschrieben.
# Auf Railway nur RAGRUN_SUPABASE_SERVICE_ROLE_KEY.
#
# Nicht der Reiter "Legacy anon, service_role API keys" (eyJ…).
# "Disable JWT-based API keys" erst, wenn Railway den sb_secret_ benutzt.
# Ein Legacy-JWT-Secret lässt sich dort nicht neu erzeugen
# (Project Settings → JWT Keys → Legacy JWT Secret hat keinen Rotate-Knopf).
# Der laufende Dienst prüft Sitzungen über JWKS und braucht es nicht.

# Staging, Projekt duhtxxbynkilpxdpcpsk
STAGING_SUPABASE_SERVICE_ROLE_KEY=
# Production, Projekt rmdqihhjjyizbuhxkxhn (Dashboard-Name ragrun, Region eu-north-1)
PRODUCTION_SUPABASE_SERVICE_ROLE_KEY=

# --- SUPABASE: Datenbank-Passwort, steckt in der DSN ---
# Nicht unter Project Settings → General oder Infrastructure.
# Linke Icon-Leiste → Database → Settings
#   https://supabase.com/dashboard/project/<ref>/database/settings
#   Knopf "Reset database password". Das neue Passwort zeigt Supabase einmal.
# Dieselbe URI auch über Connect, dort "Session pooler" wählen, Typ URI, Port 5432.
# "Direct connection" (Host db.<ref>.supabase.co) ist IPv6 und für Railway unbrauchbar.
# Passwort URL-encoden (* → %2A, ! → %21). Benutzer ist postgres.<projekt-ref>.
# Reset gilt sofort und sperrt bei Fehlversuchen den Pooler für ein paar Minuten.
# Die Passwortmanager-Einträge "Datenbank Passwort Production/Staging" sind die alten Werte.

# Staging
# postgresql://postgres.duhtxxbynkilpxdpcpsk:<pass>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
STAGING_POSTGRES_DSN=
# Production
# postgresql://postgres.rmdqihhjjyizbuhxkxhn:<pass>@aws-1-eu-north-1.pooler.supabase.com:5432/postgres
PRODUCTION_POSTGRES_DSN=

# --- CLOUDFLARE ---
# dash.cloudflare.com → Seitenleiste Zero Trust (Protect & connect)
# → Access controls → Service credentials → Service tokens
# Bestehende Namen: staging-tuxai, prod-tuxai.
# Client ID steht in der Liste. Das Client Secret zeigt Cloudflare nur beim Anlegen.
# Im Token-Menü: "Rotate secret" macht das alte Secret sofort ungültig.
# "Refresh token" verlängert nur die Laufzeit. "Copy as JSON/cURL" enthält das Secret nicht.
# Neues Token anlegen, in der Access-Policy der Tunnel-Apps
# (qdrant, qdrant-staging, embed) neben dem alten erlauben,
# Healthz prüfen, danach das alte Token löschen.
# Staging-Token → RAILWAY_STAGING, Production-Token → RAILWAY_PRODUCTION.

STAGING_CF_ACCESS_CLIENT_ID=
STAGING_CF_ACCESS_CLIENT_SECRET=
PRODUCTION_CF_ACCESS_CLIENT_ID=
PRODUCTION_CF_ACCESS_CLIENT_SECRET=

# --- QDRANT ---
# Kein Dashboard. Neu: openssl rand -hex 32
# Ein Key. Ziele: RAILWAY_STAGING, RAILWAY_PRODUCTION, TUXAI (~/ragrun-server/.env).
# Reihenfolge: apply.sh --apply ohne --redeploy, Key auf dem Pulse, Qdrant neu starten,
# dann apply.sh --apply --redeploy.
QDRANT_API_KEY=

# --- DEEPSEEK ---
# Ein Key. Ziele: RAILWAY_STAGING und RAILWAY_PRODUCTION.
# DeepSeek Console → API keys → neuen Key anlegen.
# Alten Key erst widerrufen, wenn Railway den neuen hat.
DEEPSEEK_API_KEY=
