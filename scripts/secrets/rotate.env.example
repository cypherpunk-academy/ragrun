# Kopie:  cp scripts/secrets/rotate.env.example scripts/secrets/rotate.env
# Dann nur die Werte ausfüllen, die du wirklich neu setzt.
# Leere Zeilen = diese Variable überspringen.
#
# Niemals committen. Rechte: chmod 600 scripts/secrets/rotate.env

# --- Ziele (1 = ja, 0 = nein) ---
APPLY_RAILWAY_STAGING=1
APPLY_RAILWAY_PRODUCTION=1
APPLY_LOCAL_RAGRUN=1
APPLY_LOCAL_RAGPREP=1
APPLY_GITHUB=1
APPLY_TUXAI=0
APPLY_EAS=0

RAILWAY_PROJECT_ID=4fc5cea8-9f49-42af-b624-a0f3e5232245
RAILWAY_PRODUCTION_SERVICE=ragrun
RAILWAY_STAGING_SERVICE=ragrun-staging

# GitHub-Repo für den Staging-Keepalive (anon key)
GITHUB_REPO=cypherpunk-academy/ragrun

# Optional: Pulse per SSH updaten (nur mit APPLY_TUXAI=1)
TUXAI_SSH_HOST=
TUXAI_ENV_REMOTE=~/ragrun-server/.env

# --- Geteilt: Staging + Production + Tuxai ---
# Neu: openssl rand -hex 32
QDRANT_API_KEY=

# Tailscale → admin console → reusable auth key (tag:ragrun empfohlen). Nie lokal/Dev setzen.
STAGING_TS_AUTHKEY=
PRODUCTION_TS_AUTHKEY=

# DeepSeek Console → API keys
DEEPSEEK_API_KEY=

# Hugging Face (steht noch auf Railway, Query-Pfad ist http/Tuxai)
HF_TOKEN=

# Neu empfohlen, wenn die öffentlichen /api/v1/rag und /admin-Routen zu sollen:
# openssl rand -hex 32
INTERNAL_API_KEY=

# --- Staging (Supabase-Projekt duhtxxbynkilpxdpcpsk) ---
# Dashboard → Project Settings → API Keys / Database
STAGING_SUPABASE_ANON_KEY=
STAGING_SUPABASE_SERVICE_ROLE_KEY=
STAGING_SUPABASE_JWT_SECRET=
# postgresql://postgres.duhtxxbynkilpxdpcpsk:<url-encoded-pass>@<pooler>:5432/postgres
STAGING_POSTGRES_DSN=

# --- Production (Supabase-Projekt rmdqihhjjyizbuhxkxhn) ---
PRODUCTION_SUPABASE_ANON_KEY=
PRODUCTION_SUPABASE_SERVICE_ROLE_KEY=
PRODUCTION_SUPABASE_JWT_SECRET=
# postgresql://postgres.rmdqihhjjyizbuhxkxhn:<url-encoded-pass>@<pooler>:5432/postgres
PRODUCTION_POSTGRES_DSN=

# Grafana auf dem Pulse (nur APPLY_TUXAI)
GRAFANA_ADMIN_PASSWORD=
