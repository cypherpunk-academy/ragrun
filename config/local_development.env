# Local Vector Database Environment Configuration
# Copy this file to .env to use for local development

# Vector Database Configuration
VECTOR_DB_TYPE=local
LOCAL_VECTOR_DB_PATH=./data/vector_db
LOCAL_VECTOR_COLLECTION_NAME=philosophical_768

# Embeddings Configuration
EMBEDDINGS_MODEL=T-Systems-onsite/cross-en-de-roberta-sentence-transformer
EMBEDDINGS_DIMENSION=768
LOCAL_EMBEDDING_SERVICE_URL=http://localhost:8001

# ChromaDB Configuration
CHROMADB_ANONYMIZED_TELEMETRY=false
CHROMADB_ALLOW_RESET=true

# Performance Settings
BATCH_SIZE=32
EMBEDDING_CACHE_SIZE=10000

# Backup Configuration
BACKUP_PATH=./data/backups
BACKUP_ENABLED=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_PATH=./data/logs

# MongoDB Settings (unchanged)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=rag_server

# API Settings (unchanged)
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings
BACKEND_CORS_ORIGINS=["*"]

# LLM Settings (keep existing)
OPENAI_API_KEY=your-openai-key-here
DEFAULT_LLM_MODEL=gpt-4o
DEEPSEEK_API_KEY=your-deepseek-key-here
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_PROVIDER=openai

# Environment
ENVIRONMENT=development
DEBUG=true

# Performance Settings
USE_MPS=true
MAX_QUERY_RESULTS=100
CACHE_SIZE=1000

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
RATE_LIMIT_BURST=10

# Pinecone Settings (for rollback option - leave empty for local development)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=
PINECONE_HOST= 